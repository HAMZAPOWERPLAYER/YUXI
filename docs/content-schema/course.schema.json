{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "needsHumanReview": {
      "type": "boolean",
      "const": true
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "course": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "units": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "order": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              },
              "titleUr": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "[\\u0600-\\u06FF]"
              },
              "titleEn": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800,
                "pattern": "[A-Za-z]"
              },
              "icon": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            },
            "required": ["id", "order", "titleUr", "titleEn", "icon"],
            "additionalProperties": false
          }
        }
      },
      "required": ["id", "version", "units"],
      "additionalProperties": false
    }
  },
  "required": ["needsHumanReview", "schemaVersion", "course"],
  "additionalProperties": false
}
