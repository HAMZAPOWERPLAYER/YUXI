{
  "name": "yuxi",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "check:network": "node scripts/check-no-network.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:network",
    "licenses": "node scripts/generate-licenses.mjs",
    "verify": "npm run check && npx expo-doctor"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts",
      "<rootDir>/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/features/srs/**/*.ts",
      "src/features/progress/**/*.ts",
      "src/features/quiz/selection.ts",
      "src/features/quiz/engine.ts",
      "src/db/migrations/**/*.ts",
      "src/features/kana/data/**/*.ts",
      "src/features/kana/mastery.ts",
      "src/features/kana/selectors.ts",
      "src/features/settings/settingsModel.ts",
      "src/features/backup/backupModel.ts",
      "src/features/backup/backupService.ts",
      "src/features/stats/statsModel.ts",
      "src/features/study/studyService.ts",
      "src/features/reminders/**/*.ts",
      "src/db/repositories/**/*.ts",
      "src/services/clock.ts",
      "src/services/haptics.ts",
      "src/services/notifications.ts",
      "src/services/tts.ts",
      "src/utils/date.ts",
      "src/utils/random.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/src/db/repositories/index.ts",
      "/src/features/progress/index.ts",
      "/src/features/reminders/index.ts",
      "/src/features/srs/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 80,
        "functions": 90,
        "lines": 85
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/noto-nastaliq-urdu": "^0.4.2",
    "@expo-google-fonts/noto-sans-jp": "^0.4.4",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.0.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-sharing": "~58.0.20",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "sql.js": "^1.15.2",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
