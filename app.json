{
  "expo": {
    "name": "Yuxi: Learn Japanese",
    "slug": "yuxi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yuxi",
    "userInterfaceStyle": "dark",
    "description": "The friendly, offline, no-login way for Urdu speakers to learn Japanese kana.",
    "ios": {
      "bundleIdentifier": "com.hamzapowerplayer.yuxi",
      "supportsTablet": false
    },
    "android": {
      "package": "com.hamzapowerplayer.yuxi",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.AD_ID",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E11D2E",
          "defaultChannel": "yuxi-daily-reminder",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": false
        }
      ],
      "expo-localization",
      "expo-sharing",
      "expo-document-picker",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    }
  }
}
